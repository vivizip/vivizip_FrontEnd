{
  "expo": {
    "name": "vivizip-FrontEnd",
    "slug": "vivizip-FrontEnd",
    "version": "1.0.0",
    "scheme": "vivizip",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.solution.vivizip",
      "supportsTablet": true
    },
    "android": {
      "package": "com.solution.vivizip",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "2be3bdaa7f1144b745608b39b11289d4",
          "overrideKakaoSDKVersion": "2.11.2",
          "kotlinVersion": "2.1.20"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/PretendardVariable.ttf"]
        }
      ],
      "./plugins/with-android-keyhash-module",
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "58e8dae7-b237-4197-8f5e-95f4f2f51e4c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/58e8dae7-b237-4197-8f5e-95f4f2f51e4c"
    }
  }
}
